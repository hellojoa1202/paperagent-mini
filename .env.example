# 기본은 로컬 Ollama 실행입니다.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434/api/chat

# OpenAI API로 바꿀 때는 아래 줄의 주석을 해제하고 키를 넣으세요.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-key

# EXAONE을 OpenAI-compatible server로 띄운 경우 예시입니다.
# LLM_PROVIDER=exaone
# LLM_MODEL=exaone
# EXAONE_BASE_URL=http://localhost:8000/v1
# EXAONE_API_KEY=exaone-local

ARXIV_MAX_RESULTS=3
OUTPUT_DIR=outputs
