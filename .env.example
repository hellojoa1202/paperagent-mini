# 이 파일을 .env로 복사한 뒤 사용할 provider 하나만 활성화하세요.

# 실행 설정
ARXIV_MAX_RESULTS=3
ARXIV_MAX_ATTEMPTS=3
ARXIV_RETRY_WAIT_SECONDS=5
OUTPUT_DIR=outputs
MIN_REVIEW_SCORE=7
MAX_REVISION_ROUNDS=2
RESEARCH_GAP_EXPERIMENTS=3
PROTOTYPE_MAX_REPAIRS=2
PROTOTYPE_EXECUTE=true
PROTOTYPE_TIMEOUT_SECONDS=10

# Ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
OLLAMA_URL=http://localhost:11434/api/chat

# Anthropic API 사용 시 아래 세 줄의 주석을 해제하고 발급받은 키를 입력하세요.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=YOUR_API_KEY_HERE

# OpenAI API 사용 시 아래 세 줄의 주석을 해제하고 발급받은 키를 입력하세요.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=YOUR_API_KEY_HERE

# xAI API 사용 시 아래 네 줄의 주석을 해제하세요.
# API 주소는 XAI_BASE_URL, 발급받은 키는 XAI_API_KEY에 입력합니다.
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4.3
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_API_KEY=YOUR_API_KEY_HERE

# Groq API 사용 시 아래 세 줄의 주석을 해제하고 발급받은 키를 입력하세요.
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=YOUR_API_KEY_HERE

# LM Studio 사용 시 아래 세 줄의 주석을 해제하세요.
# 실행 중인 서버 주소는 LM_STUDIO_BASE_URL에 입력합니다.
# LLM_PROVIDER=lmstudio
# LLM_MODEL=YOUR_MODEL_NAME
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# EXAONE 호환 서버 사용 시 아래 세 줄의 주석을 해제하세요.
# 실행 중인 서버 주소는 EXAONE_BASE_URL에 입력합니다.
# LLM_PROVIDER=exaone
# LLM_MODEL=exaone
# EXAONE_BASE_URL=http://localhost:8000/v1
