# 한 블록만 골라 주석을 해제하세요. 실제 API 키가 들어가는 .env는 Git에 올리지 않습니다.

# 공통 실행 설정
ARXIV_MAX_RESULTS=3
ARXIV_MAX_ATTEMPTS=3
ARXIV_RETRY_WAIT_SECONDS=5
OUTPUT_DIR=outputs
MIN_REVIEW_SCORE=7
MAX_REVISION_ROUNDS=2

# 조아 - Ollama (API 키 불필요, 현재 기본값)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434/api/chat

# 경륜 - Anthropic Claude를 사용할 때 아래 3줄의 주석을 해제하고 위 기본 LLM 3줄은 주석 처리
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=여기에_본인_Anthropic_API_KEY

# 승현 - Groq를 사용할 때 아래 3줄의 주석을 해제하고 위 기본 LLM 3줄은 주석 처리
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=여기에_본인_Groq_API_KEY

# 정민 - OpenAI를 사용할 때 아래 3줄의 주석을 해제하고 위 기본 LLM 3줄은 주석 처리
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=여기에_본인_OpenAI_API_KEY

# 지윤 - 이번 병합 대상에서는 제외. 필요하면 OpenAI 또는 아래 로컬 LM Studio 예시 사용
# LLM_PROVIDER=lmstudio
# LLM_MODEL=qwen2.5-7b-instruct
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio

# EXAONE OpenAI-compatible 로컬 서버를 사용하는 경우
# LLM_PROVIDER=exaone
# LLM_MODEL=exaone
# EXAONE_BASE_URL=http://localhost:8000/v1
# EXAONE_API_KEY=exaone-local
