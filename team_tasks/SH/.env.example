# SH의 기존 로컬 환경
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434/api/chat

# 기존에 사용한 provider로 바꿀 수 있습니다.
